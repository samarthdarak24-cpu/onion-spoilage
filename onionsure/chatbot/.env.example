# ── Sarvam AI (STT + TTS — Indic languages) ──────────────────────────────
# Get from: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Azure OpenAI (GPT-4o LLM) ────────────────────────────────────────────
# Get from: Azure Portal → OpenAI resource → Keys and Endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Bot server ────────────────────────────────────────────────────────────
BOT_PORT=8765
# Comma-separated allowed CORS origins (your frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Optional: LLM resilience tuning ──────────────────────────────────────
LLM_REQUEST_TIMEOUT_S=12.0
LLM_CONNECT_TIMEOUT_S=3.0
LLM_MAX_RETRIES=4

# ── Optional: Per-language TTS voice override ─────────────────────────────
# e.g. TTS_VOICE_HI=anushka   (Sarvam voice name)
# TTS_VOICE_HI=shubh
# TTS_VOICE_MR=shubh
