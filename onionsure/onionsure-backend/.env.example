# ============================================================
# OnionSure Backend — Environment Variables
# Copy to `.env` and fill in. NEVER commit real secrets.
# ============================================================

# --- Core ---------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database -----------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onionsure?schema=public

# --- Auth ---------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- AI services --------------------------------------------
# AI_MODE=MOCK    -> deterministic in-process mock analyzers (no Python needed)
# AI_MODE=PYTHON  -> call the Python services over HTTP / subprocess
AI_MODE=MOCK
USE_PYTHON=false
PYTHON_BIN=python3
AI_VISION_URL=http://localhost:8001
AI_GAS_URL=http://localhost:8002
FUSION_SERVICE_URL=http://localhost:8003

# --- Storage ------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
STORAGE_DRIVER=local

# --- URLs ---------------------------------------------------
PUBLIC_BASE_URL=http://localhost:4000
QR_BASE_URL=http://localhost:3000/verify
CORS_ORIGIN=http://localhost:3000

# --- Fusion defaults (overridable at runtime by ADMIN) ------
FUSION_WEIGHT_VISION=0.50
FUSION_WEIGHT_GAS=0.30
FUSION_WEIGHT_ENVIRONMENT=0.20

# --- Grading thresholds (overridable at runtime by ADMIN) ---
GRADE_A_THRESHOLD=85
URS_THRESHOLD=65

# --- Early spoilage rule ------------------------------------
ALERT_VISION_ABOVE=78

# --- Sensor -------------------------------------------------
SENSOR_DWELL_SECONDS=30
